# Copie para .env (nunca commitado) e preencha com os valores reais.

# Autonomous Database 23ai (Always Free) - ver PLANO_DESENVOLVIMENTO.md Passo 3
ORACLE_DB_USER=ADMIN
ORACLE_DB_PASSWORD=
# Alias de conexao do tnsnames.ora dentro da wallet, ex.: <db_name>_medium
ORACLE_DB_DSN=
# Pasta onde a wallet foi extraida (contem tnsnames.ora, sqlnet.ora, ewallet.pem)
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=

# Groq API (Always Free tier) - LLM de geracao, ver PLANO_DESENVOLVIMENTO.md Passo 5
GROQ_API_KEY=
